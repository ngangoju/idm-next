{
  "name": "@idm-next/app",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "test": "node --test --test-timeout=60000 'src/main/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "dev:renderer": "vite",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@idm-next/core": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.3",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "electron-builder": "^26.0.0"
  },
  "description": "A modern download manager with Chrome/Brave integration.",
  "author": "IDM-Next",
  "license": "MIT",
  "build": {
    "appId": "com.idmnext.app",
    "productName": "IDM-Next",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  }
}
