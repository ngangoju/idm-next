{
  "manifest_version": 3,
  "name": "IDM-Next",
  "version": "0.1.0",
  "description": "Detects video, audio and downloadable files on any page and hands them to IDM-Next.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "webRequest",
    "storage",
    "cookies",
    "contextMenus",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IDM-Next"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {}
}
