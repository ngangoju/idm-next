{
  "name": "idm-next",
  "private": true,
  "version": "0.1.0",
  "description": "A modern, cross-platform download manager with Chrome/Brave integration.",
  "workspaces": [
    "core",
    "app",
    "extension"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "npm test -w core && npm test -w app && npm test -w extension",
    "typecheck": "npm run typecheck -w core && npm run typecheck -w app",
    "start": "npm start -w app",
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "coverage": "c8 --reporter=text-summary --reporter=html --exclude \"**/*.test.*\" --exclude \"**/test/**\" npm test"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.70.1"
  }
}
